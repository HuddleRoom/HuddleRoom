# ── Database ──────────────────────────────────────────────────────────────────
# SQLite database (initial public release)
HUDDLEROOM_DATABASE_URL=sqlite+aiosqlite:///huddleroom.db

# ── API ───────────────────────────────────────────────────────────────────────
# Enable application debug mode
HUDDLEROOM_DEBUG=false
# Optional debug log file. Contains redacted LLM requests and responses when HUDDLEROOM_DEBUG=true.
# HUDDLEROOM_LOG_FILE=logs/huddleroom-debug.log
# Allowed CORS origins (JSON list)
# HUDDLEROOM_CORS_ORIGINS=["*"]
# Base URL agents use to reach this API
# HUDDLEROOM_API_BASE_URL=http://localhost:8000
# Agent workspace directory (default: ~/.huddleroom/workspace)
# HUDDLEROOM_WORKSPACE_DIR=~/.huddleroom/workspace

# ── Knowledge / Embeddings ────────────────────────────────────────────────────
# litellm embedding model for semantic knowledge search
# Requires OPENAI_API_KEY below
HUDDLEROOM_EMBEDDING_MODEL=text-embedding-3-small

# ── Orchestration / Meeting Control ───────────────────────────────────────────
# Model for orchestration decisions and meeting control
HUDDLEROOM_ORCHESTRATION_MODEL=openai/gpt-6.1-sol
# Per-goal, per-operator conversation allowance.
HUDDLEROOM_ORCHESTRATION_CONVERSATION_ALLOWANCE_TOKENS=50000
# Orchestration backend: api (LiteLLM, uses HUDDLEROOM_ORCHESTRATION_MODEL), claude, or codex (signed-in CLI; native default model unless HUDDLEROOM_ORCHESTRATION_CLI_MODEL is set)
HUDDLEROOM_ORCHESTRATION_BACKEND=api
# CLI model for claude/codex backends (unset = CLI default)
# HUDDLEROOM_ORCHESTRATION_CLI_MODEL=
# Optional effort: none|minimal|low|medium|high|xhigh|max (unset = backend default)
# HUDDLEROOM_ORCHESTRATION_EFFORT=high
# Project advisor lifetime token cap: -1 unlimited, 0 disabled
HUDDLEROOM_ORCHESTRATION_ADVISOR_ALLOWANCE_TOKENS=-1
HUDDLEROOM_ORCHESTRATION_CHECKPOINT_MAX_QUESTIONS=5
HUDDLEROOM_ORCHESTRATION_CONVERSATION_INVESTIGATION_ENABLED=true
HUDDLEROOM_ORCHESTRATION_CONVERSATION_STEERING_ENABLED=true
# Durable supervision: bounded reconciliation and event coalescing defaults.
HUDDLEROOM_ORCHESTRATION_RECONCILE_INTERVAL_SECONDS=30
HUDDLEROOM_ORCHESTRATION_EVENT_COALESCE_SECONDS=1
HUDDLEROOM_ORCHESTRATION_SEMANTIC_PROGRESS_SECONDS=120
HUDDLEROOM_ORCHESTRATION_SWEEP_GOAL_LIMIT=100
HUDDLEROOM_ORCHESTRATION_SWEEP_SECONDS_LIMIT=5
# Optional meeting-only override (defaults to HUDDLEROOM_ORCHESTRATION_MODEL)
# HUDDLEROOM_MEETING_CONTROL_MODEL=openai/gpt-6.1-sol

# ── Agent Effectiveness ───────────────────────────────────────────────────────
HUDDLEROOM_EFFECTIVENESS_RECOVERY_THRESHOLD=2
HUDDLEROOM_EFFECTIVENESS_FAILED_SESSION_THRESHOLD=3
HUDDLEROOM_EFFECTIVENESS_INACTIVITY_HOURS=24

# ── Credentials / OneCLI ──────────────────────────────────────────────────────
# direct (default) or onecli
HUDDLEROOM_CREDENTIAL_MODE=direct
# HUDDLEROOM_ONECLI_AGENT=my-agent
# HUDDLEROOM_ONECLI_MANAGEMENT_URL=http://127.0.0.1:10256
# HUDDLEROOM_ONECLI_GATEWAY_URL=http://127.0.0.1:10255
# CLI runtimes that use their own signed-in auth instead of the OneCLI gateway (JSON list)
# HUDDLEROOM_ONECLI_NATIVE_AUTH_RUNTIMES=["claude_code", "codex"]

# Rally setting names remain compatible for one release and emit a deprecation warning.

# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# Required for API adapter agents and knowledge embeddings.
# Set at least one. litellm uses these as standard env vars.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OLLAMA_API_BASE=http://localhost:11434
